+     * runs again, and there was previously no way to resize a preview that
+     * is already running.
+     *
+     * This applies a new size/position to the live frameContainerLayout
+     * directly. It touches ONLY that view's LayoutParams — never mCamera,
+     * mPreview, or the CameraActivity's MediaRecorder — so an in-progress
+     * recording is not affected. This is deliberately the same pair of
+     * calls (mutate LayoutParams, then invalidate()+requestLayout()) that
+     * onConfigurationChanged() below already performs on every screen
+     * rotation, including while recording — that existing, already-relied-
+     * upon behavior is the evidence this kind of live layout change is
+     * safe here, not a new assumption.
+     */
+    public void updateRect(final int newX, final int newY, final Integer newWidth, final Integer newHeight) {
+        this.x = newX;
+        this.y = newY;
+        this.width = newWidth == null ? ViewGroup.LayoutParams.MATCH_PARENT : newWidth;
+        this.height = newHeight == null ? ViewGroup.LayoutParams.MATCH_PARENT : newHeight;
+
+        final Activity activity = getActivity();
+        if (activity == null || frameContainerLayout == null) {
+            return; // preview isn't running yet — nothing on screen to resize
+        }
+
+        activity.runOnUiThread(new Runnable() {
+            @Override
+            public void run() {
+                FrameLayout.LayoutParams layoutParams = new FrameLayout.LayoutParams(width, height);
