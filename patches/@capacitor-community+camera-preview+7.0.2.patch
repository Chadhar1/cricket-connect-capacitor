+    /**
+     * CricketConnect patch (Record Match small-window / live resize).
+     *
+     * Resizes/repositions an ALREADY-RUNNING preview in place — start() only
+     * accepts x/y/width/height once, at creation, with no way to change them
+     * afterward. This lets a caller shrink the live preview into a small
+     * window (so app UI can stay usable underneath/around it) or expand it
+     * back to full screen, without stopping the preview or touching an
+     * in-progress recording — see CameraActivity.updateRect()'s own comment
+     * for why that is safe.
+     *
+     * Same option names/units (dp) as start(), same conversion, so callers
+     * can reuse the exact values they already pass there.
+     */
+    @PluginMethod
+    public void resizePreview(final PluginCall call) {
+        if (this.hasCamera(call) == false) {
+            call.reject("Camera is not running");
+            return;
+        }
+
+        final Integer x = call.getInt("x", 0);
+        final Integer y = call.getInt("y", 0);
+        final Integer width = call.getInt("width", 0);
+        final Integer height = call.getInt("height", 0);
+        final Integer paddingBottom = call.getInt("paddingBottom", 0);
+
+        bridge
+            .getActivity()
+            .runOnUiThread(
+                new Runnable() {
+                    @Override
+                    public void run() {
+                        DisplayMetrics metrics = getBridge().getActivity().getResources().getDisplayMetrics();
+
+                        int computedX = (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, x, metrics);
+                        int computedY = (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, y, metrics);
+
+                        int computedPaddingBottom = paddingBottom != 0
+                            ? (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, paddingBottom, metrics)
+                            : 0;
+
+                        Integer computedWidth = width != 0
+                            ? (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, width, metrics)
+                            : null;
+                        Integer computedHeight = height != 0
+                            ? (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, height, metrics) - computedPaddingBottom
+                            : null;
+
+                        fragment.updateRect(computedX, computedY, computedWidth, computedHeight);
+                        call.resolve();
+                    }
+                }
+            );
+    }
